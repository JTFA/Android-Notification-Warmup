<?xml version="1.0" encoding="utf-8"?>
<!--
  授予写入安全设置权限的对话框（0.7.20-M6 / 41）。

  三块：正文（这条命令做什么、有 / 没有特权通道各自怎么走）、命令原文、状态一行
  （已授予 / 还没授予）。命令用等宽字并且可长按选中：它是要被原样粘到电脑终端里去的，
  字形不能把 l/1、O/0 这类混掉。0.7.19 时这里放的是两条 settings put secure，
  0.7.20 换成一条 pm grant（见 core/AccessibilityGrant 的类注释）。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tv_grant_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/tv_grant_command"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="?attr/colorSurfaceContainer"
            android:breakStrategy="simple"
            android:lineSpacingExtra="2dp"
            android:padding="12dp"
            android:textIsSelectable="true"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurface"
            android:typeface="monospace" />

        <TextView
            android:id="@+id/tv_grant_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

    </LinearLayout>
</ScrollView>
