<?xml version="1.0" encoding="utf-8"?>
<!--
  名单页的一行应用（0.7.11-M6 / 32 起是「上块 + 下块」两段）。

  上块：勾选框 · 图标 ·（应用名 + 包名）·（设置 / 试一次，同一行）
  下块：三枚圆角标签 —— 权重、唤醒方式（灰底），结论（可预热 = 浅绿，不可预热 = 浅红）
  末尾：一行 1dp 的分隔线（最后一行由适配器隐藏，只出现在两行之间）

  下块的左边距 = 勾选框宽度 + 图标外边距，也就是**从图标左边缘开始**：这一段横贯到行右边距，
  上块右边被两枚按钮占着，所以下块比上块的文字区更宽，结论那一行因此少换行。
  勾选框宽度钉成 48dp 就是为了这个对齐 —— wrap_content 是主题给的动态宽度，
  XML 里没法拿它当边距。

  包名最多两行、再长末尾省略号；结论那行不截断（它才是这一行最要紧的信息）。

  只有勾选框能切换勾选；长按一行与「设置」等价。整行底色的开关在适配器手里（勾过的行加一层底色），
  foreground 放波纹（长按设置时仍有按压反馈），background 留给那一层底色。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground"
    android:longClickable="true"
    android:minHeight="72dp"
    android:orientation="vertical"
    android:paddingStart="6dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp"
    tools:ignore="Overdraw">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <CheckBox
            android:id="@+id/app_selected"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:minWidth="0dp" />

        <ImageView
            android:id="@+id/app_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="2dp"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/app_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceBodyLarge" />

            <TextView
                android:id="@+id/app_package"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:breakStrategy="simple"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="com.tencent.mm.plugin.something.quite.long" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/app_settings"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="@string/applist_settings_button"
                android:textSize="12sp"
                app:cornerRadius="14dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/app_test"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="@string/applist_test"
                android:textSize="12sp"
                app:cornerRadius="14dp" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="50dp"
        android:layout_marginTop="6dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/app_weight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip"
                android:backgroundTint="?attr/colorSurfaceVariant"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="权重：普通" />

            <TextView
                android:id="@+id/app_method"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_chip"
                android:backgroundTint="?attr/colorSurfaceVariant"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="唤醒方式：唤醒后台" />

        </LinearLayout>

        <TextView
            android:id="@+id/app_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_chip"
            android:breakStrategy="simple"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            tools:text="可预热：Service（需要开启关联启动，已开启请忽略）" />

    </LinearLayout>

    <!-- 应用之间的分隔线。最后一行由适配器隐藏，所以它真的只在两行之间出现。 -->
    <View
        android:id="@+id/app_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="@color/row_divider" />

</LinearLayout>
