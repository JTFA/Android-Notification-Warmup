<?xml version="1.0" encoding="utf-8"?>
<!--
  状态页（0.7.29-M6 / 50 起：模块化重排）。

  「权限」与「运行状态」两张卡里不再是一行一条、每行还带一枚按钮，而是一格一格：
  · 权限       = 2 × 2 四格：标题 + 状态 + 说明，电池那格多一句建议；整格可点 = 原来的「去授权」；
  · 运行状态   = 2 + 2 + 1 五格：短指标两格一行，预热那格独占一行（它的值最长，还带一行名单摘要）。

  同一行里的格子用 layout_height="match_parent"：LinearLayout 会把这一行里最高的那格的高度
  套给其它格（框架里的 forceUniformHeight），所以一行的格子底边是对齐的，不用在代码里量高度。
  「无障碍服务连接」那一格去掉了（0.7.29-M6 / 50，用户要求）；那条信息仍在日志里：
  连接状态一翻转就写一行「无障碍服务连接 → 已连接 / 未连接」（见 StatusFragment 的迁移日志）。

  0.7.53-M6 / 74 起去掉「预热覆盖」与「现场验证」两段，页面只剩权限、运行状态和「重启监听服务」。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/section_permissions"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.jtfa.notificationfixer.ui.StatusBlockView
                        android:id="@+id/block_listener"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1" />

                    <com.jtfa.notificationfixer.ui.StatusBlockView
                        android:id="@+id/block_accessibility"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.jtfa.notificationfixer.ui.StatusBlockView
                        android:id="@+id/block_post_notifications"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1" />

                    <com.jtfa.notificationfixer.ui.StatusBlockView
                        android:id="@+id/block_battery"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/section_runtime"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.jtfa.notificationfixer.ui.StatusBlockView
                        android:id="@+id/block_service"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1" />

                    <com.jtfa.notificationfixer.ui.StatusBlockView
                        android:id="@+id/block_nls"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.jtfa.notificationfixer.ui.StatusBlockView
                        android:id="@+id/block_shade"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1" />

                    <com.jtfa.notificationfixer.ui.StatusBlockView
                        android:id="@+id/block_foreground"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1" />
                </LinearLayout>

                <com.jtfa.notificationfixer.ui.StatusBlockView
                    android:id="@+id/block_warm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_restart_service"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginBottom="16dp"
            android:text="@string/action_restart_service" />

    </LinearLayout>
</ScrollView>
