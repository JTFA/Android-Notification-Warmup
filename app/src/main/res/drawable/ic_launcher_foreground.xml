                android:centerColor="#FFF56A10"
                android:endColor="#FFB81B06" />
        </aapt:attr>
    </path>

    <!-- 火苗：左边一簇 -->
    <path
        android:pathData="M45,71 C 42,74.5 39.5,76.5 39.5,79.5 C 39.5,82.5 42,84.5 45,84.5 C 48,84.5 50,82.5 50,79.5 C 50,76.5 47,74.5 45,71 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="52"
                android:endX="0"
                android:endY="86"
                android:startColor="#FFFFC24A"
                android:centerColor="#FFF56A10"
                android:endColor="#FFB81B06" />
