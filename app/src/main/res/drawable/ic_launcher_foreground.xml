        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="52"
                android:endX="0"
                android:endY="86"
                android:startColor="#FFFFC24A"
                android:centerColor="#FFF56A10"
                android:endColor="#FFB81B06" />
