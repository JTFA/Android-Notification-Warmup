    <!-- 首次安装声明 -->
    <string name="disclaimer_title">声明</string>
    <string name="disclaimer_message">本应用开发初衷是解决ColorOS中点开通知时过渡动画缺失问题，通过无障碍监控下拉通知面板、锁屏点亮、收到横幅通知场景，并预先唤醒发通知的应用的后台进程，以避免点开通知时因进程冷启动而卡顿。本应用未申请网络权限，不会收集您的信息。使用本应用可能会导致耗电增加。</string>
    <string name="disclaimer_disagree">不同意</string>
    <string name="disclaimer_agree">同意</string>

